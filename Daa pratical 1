int main()
{
    const int SIZE = 100;

    vector<int> numbers(SIZE);

    // Random number generator
    random_device rd;
    mt19937 generator(rd());
    uniform_int_distribution<int> distribution(1, 999);

    // Generate random values
    for (int& value : numbers)
    {
        value = distribution(generator);
    }

    cout << "============================================\n";
    cout << "       SORTING ALGORITHM COMPARISON\n";
    cout << "============================================\n";

    cout << "Number of Elements : " << SIZE << "\n\n";

    cout << "Algorithm          Execution Time\n";
    cout << "--------------------------------------------\n";

    cout << "Bubble Sort        : "
         << calculateTime(numbers, 1)
         << " microseconds\n";

    cout << "Selection Sort     : "
         << calculateTime(numbers, 2)
         << " microseconds\n";

    cout << "Insertion Sort     : "
         << calculateTime(numbers, 3)
         << " microseconds\n";

    cout << "Merge Sort         : "
         << calculateTime(numbers, 4)
         << " microseconds\n";

    cout << "Quick Sort         : "
         << calculateTime(numbers, 5)
         << " microseconds\n";

    cout << "============================================\n";

    return 0;
}